# Copiar a .env y cambiar los valores. .env NO se sube al repositorio.
POSTGRES_USER=ianamed
POSTGRES_PASSWORD=cambiar
# Puerto del contenedor en tu equipo. Si ya tienes PostgreSQL instalado en 5432, usa 5433 y cámbialo también en las URL.
POSTGRES_PORT=5432
# Usuario dueño de las tablas (migraciones y semilla)
DATABASE_ADMIN_URL=postgres://ianamed:cambiar@localhost:5432/ianamed
# Usuario de la aplicación (sin UPDATE/DELETE en la bitácora). db:migrate le asigna APP_DB_PASSWORD.
APP_DB_PASSWORD=cambiar
DATABASE_URL=postgres://ianamed_app:cambiar@localhost:5432/ianamed
# Mínimo 32 caracteres aleatorios: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Clave AES-256 de los datos clínicos: 32 bytes en hex (o base64): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_KEY=
# Contraseña de los usuarios de prueba que crea db:seed (Argon2id)
SEED_PASSWORD=
# Proxies de confianza delante de la app (0 en local, 1 en Render)
TRUST_PROXY=0
PORT=3000
